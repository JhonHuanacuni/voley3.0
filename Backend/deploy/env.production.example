# Copiar como Backend/.env EN EL SERVIDOR:
# /home/usercodex/vitavoley_src/Backend/.env
#
# Contraseña MySQL = la de usercodex (la misma de Academia / DecoCake / Kaysen).
# En SSH: grep DB_PASSWORD ~/academia_src/Backend/.env
#
# SECRET_KEY nuevo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=cambia-esto-por-un-secret-key-largo-vitavoley
